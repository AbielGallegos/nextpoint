# Copia este archivo como .env o, mejor, ejecuta:  python manage.py init_env --debug
# NUNCA subas .env al repositorio.

# Obligatoria fuera de modo desarrollo. init_env la genera aleatoria.
NEXTPOINT_SECRET_KEY=
# Contraseña de TODAS las cuentas demo (≥ 10 caracteres). init_env la genera aleatoria.
NEXTPOINT_DEMO_PASSWORD=
# demo | dev | test | production  (reset_demo y restore_demo se bloquean en production)
NEXTPOINT_ENV=demo
# 1 solo en tu computadora de desarrollo
NEXTPOINT_DEBUG=0
NEXTPOINT_ALLOWED_HOSTS=localhost,127.0.0.1
# NEXTPOINT_CSRF_TRUSTED_ORIGINS=https://tu-dominio
# Activa cookies Secure cuando sirvas por HTTPS
NEXTPOINT_SECURE_COOKIES=0
# Vacío = SQLite local (nextpoint.sqlite3). Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/nextpoint
DATABASE_URL=
# Muestra la lista de correos demo (sin contraseña) en la pantalla de acceso
NEXTPOINT_SHOW_DEMO_ACCOUNTS=1
NEXTPOINT_LOG_LEVEL=WARNING
